{
  "name": "instrimate",
  "version": "1.0.0",
  "description": "Instrimate helps teachers manage their classes wisely and efficiently",
  "license": "ISC",
  "author": "Abulfazl Amiri",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:sync": "prisma db push && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.39.0",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/testing": "^12.5.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prisma": "^7.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
